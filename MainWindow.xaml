<Window x:Class="SILENTREAPER.DynamicNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SILENTREAPER Dynamic Notch"
        Width="190" Height="36"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid x:Name="Root" ClipToBounds="False">
        <Border x:Name="GlassShell" CornerRadius="18"
                BorderThickness="1" BorderBrush="#5AFFFFFF"
                Background="#F20A0A0D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.32" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Border CornerRadius="18" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#24FFFFFF" Offset="0"/>
                            <GradientStop Color="#04FFFFFF" Offset="0.38"/>
                            <GradientStop Color="#12000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="TopReflection" Height="1" VerticalAlignment="Top"
                        Margin="18,1,18,0" CornerRadius="1" Background="#BFFFFFFF"
                        Opacity="0.55" IsHitTestVisible="False"/>
                <Grid x:Name="CompactView" Margin="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#FFB8F4D0" Margin="0,0,7,0"/>
                        <TextBlock x:Name="CompactText" Text="SILENTREAPER" Foreground="#FFECECF1"
                                   FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="22,18,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="DYNAMIC NOTCH" Foreground="#FFBFC2CC" FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="Headline" Text="Your system at a glance" Foreground="White"
                                       FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="PinButton" DockPanel.Dock="Right" Content="⌃" Width="30" Height="28"
                                Click="PinButton_Click" ToolTip="Collapse notch" Background="#20FFFFFF"
                                Foreground="White" BorderBrush="#35FFFFFF" FontSize="15" Cursor="Hand"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="13" Background="#19FFFFFF" BorderBrush="#20FFFFFF"
                                BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="BATTERY" Foreground="#FFB9BBC5" FontSize="9"/>
                                <TextBlock x:Name="BatteryValue" Text="--" Foreground="White" FontSize="22"
                                           FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock x:Name="BatteryState" Text="Checking…" Foreground="#FFC9CBD3"
                                           FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="13" Background="#19FFFFFF" BorderBrush="#20FFFFFF"
                                BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="PROCESSOR" Foreground="#FFB9BBC5" FontSize="9"/>
                                <TextBlock x:Name="CpuValue" Text="--%" Foreground="White" FontSize="22"
                                           FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock Text="Total CPU load" Foreground="#FFC9CBD3" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" CornerRadius="13" Background="#19FFFFFF" BorderBrush="#20FFFFFF"
                                BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Foreground="#FFB9BBC5" FontSize="9"/>
                                <TextBlock x:Name="RamValue" Text="--%" Foreground="White" FontSize="22"
                                           FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock x:Name="RamState" Text="RAM usage" Foreground="#FFC9CBD3" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="FooterText" Text="Windows • Adaptive mode" Foreground="#FF9FA2AD"
                                   FontSize="10" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshButton_Click"
                                Padding="12,5" Background="#24FFFFFF" Foreground="White"
                                BorderBrush="#35FFFFFF" Cursor="Hand"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
